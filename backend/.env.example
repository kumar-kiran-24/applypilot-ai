# =============================================================================
# ApplyPilot AI backend - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="ApplyPilot AI Backend"
APP_VERSION="0.1.0"
# development | testing | staging | production
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
# Interactive docs (/docs, /redoc, /openapi.json). Empty/omitted means "on
# outside production"; production always disables them and rejects an explicit
# true, because they describe every internal route to anonymous visitors.
API_DOCS_ENABLED=

# --- Database (PostgreSQL, asyncpg driver) -----------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:change-me@localhost:5432/applypilot"

# --- Cache / queue -----------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# --- LLM (Groq) --------------------------------------------------------------
GROQ_API_KEY=""
# Production model IDs as of Nov 2026: openai/gpt-oss-120b (default), openai/gpt-oss-20b
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TEMPERATURE=0.0

# --- Vector store (Qdrant) ---------------------------------------------------
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# --- Google OAuth ------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly, including the
# host. Use ONE host for the whole flow; this template uses http://127.0.0.1:8000
# and that is what you register in Google Cloud Console. Do not mix localhost and
# 127.0.0.1 - they are different sites for cookies, so the OAuth state cookie
# would not reach the callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/api/v1/auth/google/callback"

# Signs the short-lived OAuth session cookie (state/nonce). Required, min 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_SESSION_SECRET=""
# Lifetime of that state cookie in seconds (one flow, not a login session).
OAUTH_SESSION_MAX_AGE_SECONDS=600

# --- Gmail integration -------------------------------------------------------
# Encrypts Gmail refresh tokens at rest (Fernet). This is a SEPARATE secret from
# JWT_SECRET_KEY and OAUTH_SESSION_SECRET. Generate it once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up together with the database: without it every stored refresh token
# becomes undecryptable and every user must reconnect Gmail. Never commit it.
GMAIL_TOKEN_ENCRYPTION_KEY=""
# Gmail OAuth callback. Register it in Google Cloud Console alongside the login
# callback. Required (and https) in production; in development an empty value is
# derived from the request host, but set it explicitly to the registered value.
GMAIL_REDIRECT_URI="http://127.0.0.1:8000/api/v1/gmail/callback"
# Where the browser lands after a successful Gmail authorization (a frontend
# route). Its origin MUST appear in BACKEND_CORS_ORIGINS below; arbitrary
# redirect targets are rejected at startup. Leave empty to keep the JSON reply.
GMAIL_FRONTEND_REDIRECT_URI="http://127.0.0.1:3000/gmail/callback"
GMAIL_API_TIMEOUT_SECONDS=30
GMAIL_MAX_RETRIES=2

# --- Resume storage ----------------------------------------------------------
# Backend for uploaded resume PDFs. Only `local` is implemented; the service is
# written behind a storage abstraction so a bucket backend can be added later.
RESUME_STORAGE_BACKEND="local"
# Directory for uploaded files. Relative paths resolve from the backend working
# directory. NEVER point this at a web-served folder and never commit it.
RESUME_STORAGE_DIR="var/resumes"
# Maximum accepted upload size in bytes (default 10 MB, max 50 MB).
RESUME_MAX_FILE_SIZE_BYTES=10485760

# --- Application automation (Phase 2E) --------------------------------------
# Browser automation is opt-in. When enabled, Stage E streams the same Playwright
# page to the owning user over a single-use-ticket WebSocket. Keep one backend
# worker: browsers and view tickets live in process memory.
APPLICATION_AUTOMATION_ENABLED=false
APPLICATION_BROWSER_HEADLESS=true
APPLICATION_BROWSER_STREAMING_ENABLED=true
APPLICATION_BROWSER_SESSION_TTL_SECONDS=900
APPLICATION_BROWSER_MAX_ACTIVE_PER_USER=1
# Process-wide browser ceiling. Each Chromium is several hundred MB; size this
# against host RAM and the systemd MemoryMax in deploy/systemd.
APPLICATION_MAX_ACTIVE_BROWSER_SESSIONS=8
# V8 heap ceiling per renderer (MB). Chromium may use somewhat more overall.
APPLICATION_BROWSER_JS_HEAP_MB=512
# Pin the validated DNS answer into Chromium's resolver (must stay true in
# production). Pair with the egress firewall in deploy/scripts.
APPLICATION_BROWSER_PIN_DNS=true
APPLICATION_BROWSER_VIEW_TICKET_TTL_SECONDS=45
APPLICATION_BROWSER_VIEW_TICKETS_PER_MINUTE=6
APPLICATION_BROWSER_VIEW_INPUT_PER_SECOND=120
APPLICATION_BROWSER_VIEW_MAX_SECONDS=3600

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required, min. 32 bytes (HS256); must not be the development default in production.
JWT_SECRET_KEY="dev-insecure-jwt-secret-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Dedicated frontend login callback. The backend sends the browser here with a
# single-use code (never the JWT); the Next.js BFF exchanges it for the HttpOnly
# `ap_session` cookie. Must be an absolute http(s) URL whose origin appears in
# BACKEND_CORS_ORIGINS (https in production).
AUTH_FRONTEND_REDIRECT_URI="http://127.0.0.1:3000/auth/callback"
# Lifetime of a one-time login code in seconds (10-60). Keep it short.
AUTH_CODE_EXPIRE_SECONDS=60
# Per-client limit for /auth/google/login, /auth/google/callback and
# /auth/login/exchange. Nginx limit_req is still the primary edge control.
AUTH_RATE_LIMIT_PER_MINUTE=30
# Per-principal budget for the rest of the API (authenticated calls are keyed
# by user id, anonymous ones by address). In-process: per worker, not a cluster
# quota. Health, readiness and metrics are exempt.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=240

# --- Observability -----------------------------------------------------------
# Prometheus text endpoint at /api/v1/metrics. In production a bearer token is
# REQUIRED; restrict the route to the monitoring network in Nginx as well.
METRICS_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=""
# Optional JSON webhook for unhandled errors (no vendor SDK). Only the error
# class, route, request id and status are sent - never messages or form values.
ERROR_WEBHOOK_URL=""
ERROR_WEBHOOK_TIMEOUT_SECONDS=3

# --- CORS --------------------------------------------------------------------
# JSON array of the exact frontend origins. Do NOT use ["*"] in production.
# Production additionally requires absolute https origins and rejects loopback
# hosts; the same list is the WebSocket Origin allow-list for the live view.
# The browser calls GET /api/v1/gmail/connect with credentials: "include" so the
# signed OAuth state cookie is stored for the callback.
BACKEND_CORS_ORIGINS=["http://127.0.0.1:3000"]
