# =============================================================================
# ApplyPilot AI backend - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="ApplyPilot AI Backend"
APP_VERSION="0.1.0"
# development | testing | staging | production
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# --- Database (PostgreSQL, asyncpg driver) -----------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:change-me@localhost:5432/applypilot"

# --- Cache / queue -----------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# --- LLM (Groq) --------------------------------------------------------------
GROQ_API_KEY=""
# Production model IDs as of Nov 2026: openai/gpt-oss-120b (default), openai/gpt-oss-20b
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_TEMPERATURE=0.0

# --- Vector store (Qdrant) ---------------------------------------------------
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# --- Google OAuth (Drive / Gmail) -------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google/callback"

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production (min. 32 chars, must not be the development default).
JWT_SECRET_KEY="dev-insecure-jwt-secret-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS --------------------------------------------------------------------
# JSON array. Do NOT use ["*"] in production.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
