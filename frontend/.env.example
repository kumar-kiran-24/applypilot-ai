# ---------------------------------------------------------------------------
# ApplyPilot AI - frontend configuration
# Copy to `.env.local` (git-ignored) and adjust for your machine.
# ---------------------------------------------------------------------------

# FastAPI backend, used by the Next.js server (BFF proxy) and for the Google
# login navigation. Must match the host used in the registered OAuth callbacks:
# mixing `localhost` and `127.0.0.1` breaks the backend's OAuth state cookie.
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# Lifetime of the frontend session cookie, in seconds. Matches the backend's
# ACCESS_TOKEN_EXPIRE_MINUTES default of 60 minutes.
SESSION_MAX_AGE_SECONDS="3600"

# Send the session cookie with the Secure flag. Automatically enabled in
# production builds; set to "true" when serving the app over HTTPS locally.
SESSION_COOKIE_SECURE="false"

# Google login now completes through the dedicated /auth/callback page. The
# backend sends the browser there with a one-time code (configured on the
# backend as AUTH_FRONTEND_REDIRECT_URI); this app exchanges it server-side and
# stores the JWT in the HttpOnly `ap_session` cookie. No frontend setting is
# required, and the token is never readable by browser JavaScript.
